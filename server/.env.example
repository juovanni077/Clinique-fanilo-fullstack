PORT=4000

# Change impérativement cette valeur avant tout déploiement réel.
# Elle sert à signer les jetons de connexion (JWT). Une valeur simple
# à générer : ouvre un terminal et tape `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-moi-avant-la-production

# Origine autorisée à appeler l'API (ton frontend). En local, Vite tourne
# par défaut sur ce port.
CLIENT_ORIGIN=http://localhost:5173

# --- Email (facultatif) ---
# Si ces variables sont renseignées, l'application enverra de vrais emails
# de confirmation/rappel de rendez-vous via SMTP (ex : un compte Gmail avec
# un "mot de passe d'application"). Si elles sont absentes, les notifications
# restent visibles uniquement dans l'application — rien ne casse.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Clinique Fanilo <no-reply@fanilo.mg>"

# --- SMS (facultatif, non câblé par défaut) ---
# Envoyer de vrais SMS nécessite un compte chez un fournisseur payant
# (Twilio, Vonage...). Le point d'intégration est prêt dans
# src/utils/notify.js (fonction sendSms) — il suffit d'y appeler l'API
# du fournisseur avec les identifiants ci-dessous.
SMS_PROVIDER_SID=
SMS_PROVIDER_TOKEN=
SMS_FROM_NUMBER=

# --- Assistant IA (chatbot) — facultatif mais recommandé ---
# Clé gratuite à créer sur https://aistudio.google.com (bouton "Get API key").
# Sans clé, le chatbot reste visible mais affiche un message clair au lieu
# de planter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
